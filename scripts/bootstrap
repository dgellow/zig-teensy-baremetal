#!/usr/bin/env bash
set -e

# Check if zig is available
if ! command -v zig &> /dev/null; then
    echo "Error: zig is not installed or not in PATH"
    echo "Download from: https://ziglang.org/download/"
    exit 1
fi

echo "Initializing git submodules..."
git submodule update --init --recursive || git submodule update --init

echo "Fetching zig dependencies..."
zig build --fetch || zig fetch --save || true
